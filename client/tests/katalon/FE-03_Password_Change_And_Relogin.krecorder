<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en" lang="en">
<head>
<meta content="text/html; charset=UTF-8" http-equiv="content-type" />
<title>FE-03_Password_Change_And_Relogin</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3" data-tags="">FE-03: Password Change &amp; Re-login Flow (Req 2.3, 1.1.2)</td></tr>
</thead>
<tbody>
<tr><td>open</td><td>/register<datalist></datalist></td><td></td></tr>
<tr><td>waitForElementPresent</td><td>id=fullName<datalist></datalist></td><td>5000</td></tr>
<tr><td>storeEval</td><td>"pwd_test_" + new Date().getTime() + "@nexto.com"<datalist></datalist></td><td>testEmail</td></tr>
<tr><td>type</td><td>id=fullName<datalist></datalist></td><td>Password Test User</td></tr>
<tr><td>type</td><td>id=email<datalist></datalist></td><td>${testEmail}</td></tr>
<tr><td>type</td><td>id=password<datalist></datalist></td><td>OldP@ssw0rd1!</td></tr>
<tr><td>click</td><td>id=register-submit-btn<datalist></datalist></td><td></td></tr>
<tr><td>waitForElementPresent</td><td>id=register-success-msg<datalist></datalist></td><td>5000</td></tr>
<tr><td>pause</td><td>1500<datalist></datalist></td><td></td></tr>
<tr><td>open</td><td>/login<datalist></datalist></td><td></td></tr>
<tr><td>waitForElementPresent</td><td>id=email<datalist></datalist></td><td>5000</td></tr>
<tr><td>type</td><td>id=email<datalist></datalist></td><td>${testEmail}</td></tr>
<tr><td>type</td><td>id=password<datalist></datalist></td><td>OldP@ssw0rd1!</td></tr>
<tr><td>click</td><td>id=login-submit-btn<datalist></datalist></td><td></td></tr>
<tr><td>waitForElementPresent</td><td>id=nav-link-profile<datalist></datalist></td><td>5000</td></tr>
<tr><td>click</td><td>id=nav-link-profile<datalist></datalist></td><td></td></tr>
<tr><td>waitForElementPresent</td><td>id=profile-currentPassword-input<datalist></datalist></td><td>5000</td></tr>
<tr><td>type</td><td>id=profile-currentPassword-input<datalist></datalist></td><td>OldP@ssw0rd1!</td></tr>
<tr><td>type</td><td>id=profile-newPassword-input<datalist></datalist></td><td>NewSecureP@ss2#</td></tr>
<tr><td>type</td><td>id=profile-confirmPassword-input<datalist></datalist></td><td>NewSecureP@ss2#</td></tr>
<tr><td>click</td><td>id=profile-change-password-btn<datalist></datalist></td><td></td></tr>
<tr><td>waitForElementPresent</td><td>id=profile-password-success<datalist></datalist></td><td>5000</td></tr>
<tr><td>assertText</td><td>id=profile-password-success<datalist></datalist></td><td>✓ Password changed successfully</td></tr>
<tr><td>click</td><td>id=nav-btn-logout<datalist></datalist></td><td></td></tr>
<tr><td>waitForElementPresent</td><td>id=login-submit-btn<datalist></datalist></td><td>5000</td></tr>
<tr><td>type</td><td>id=email<datalist></datalist></td><td>${testEmail}</td></tr>
<tr><td>type</td><td>id=password<datalist></datalist></td><td>OldP@ssw0rd1!</td></tr>
<tr><td>click</td><td>id=login-submit-btn<datalist></datalist></td><td></td></tr>
<tr><td>waitForElementPresent</td><td>id=login-error-msg<datalist></datalist></td><td>5000</td></tr>
<tr><td>type</td><td>id=password<datalist></datalist></td><td>NewSecureP@ss2#</td></tr>
<tr><td>click</td><td>id=login-submit-btn<datalist></datalist></td><td></td></tr>
<tr><td>waitForElementPresent</td><td>id=home-welcome-title<datalist></datalist></td><td>5000</td></tr>
<tr><td>assertText</td><td>id=home-welcome-title<datalist></datalist></td><td>Welcome to NexTo</td></tr>
</tbody></table>
</body>
</html>