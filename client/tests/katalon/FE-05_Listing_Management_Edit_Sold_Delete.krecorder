<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en" lang="en">
<head>
<meta content="text/html; charset=UTF-8" http-equiv="content-type" />
<title>FE-05_Listing_Management_Edit_Sold_Delete</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3" data-tags="">FE-05: Listing Management Flow (Req 4.4 - 4.6, Milestone 2)</td></tr>
</thead>
<tbody>
<tr><td>storeEval</td><td>"katalon_w6_" + new Date().getTime() + "@nexto.com"<datalist><option>"katalon_w6_" + new Date().getTime() + "@nexto.com"</option></datalist></td><td>testEmail</td></tr>
<tr><td>storeEval</td><td>"Listing Owner " + new Date().getTime().toString().slice(-4)<datalist><option>"Listing Owner " + new Date().getTime().toString().slice(-4)</option></datalist></td><td>testName</td></tr>
<tr><td>open</td><td>/register<datalist><option>/register</option></datalist></td><td></td></tr>
<tr><td>waitForElementPresent</td><td>id=fullName<datalist></datalist></td><td>5000</td></tr>
<tr><td>type</td><td>id=fullName<datalist></datalist></td><td>${testName}</td></tr>
<tr><td>type</td><td>id=email<datalist></datalist></td><td>${testEmail}</td></tr>
<tr><td>type</td><td>id=password<datalist></datalist></td><td>P@ssw0rd1!</td></tr>
<tr><td>click</td><td>id=register-submit-btn<datalist></datalist></td><td></td></tr>
<tr><td>waitForElementPresent</td><td>id=register-success-msg<datalist></datalist></td><td>5000</td></tr>
<tr><td>open</td><td>/login<datalist></datalist></td><td></td></tr>
<tr><td>waitForElementPresent</td><td>id=email<datalist></datalist></td><td>5000</td></tr>
<tr><td>type</td><td>id=email<datalist></datalist></td><td>${testEmail}</td></tr>
<tr><td>type</td><td>id=password<datalist></datalist></td><td>P@ssw0rd1!</td></tr>
<tr><td>click</td><td>id=login-submit-btn<datalist></datalist></td><td></td></tr>
<tr><td>waitForElementPresent</td><td>id=nav-link-create-listing<datalist><option>id=nav-link-create-listing</option></datalist></td><td>5000</td></tr>
<tr><td>click</td><td>id=nav-link-create-listing<datalist><option>/create-listing</option><option>id=create-listing</option><option>id=nav-link-create-listing</option></datalist></td><td></td></tr>
<tr><td>waitForElementPresent</td><td>id=listing-title-input<datalist><option>id=listing-title-input</option></datalist></td><td>5000</td></tr>
<tr><td>type</td><td>id=listing-title-input<datalist></datalist></td><td>Bose QuietComfort 45 Headphones</td></tr>
<tr><td>select</td><td>id=listing-category-select<datalist></datalist></td><td>index=1</td></tr>
<tr><td>type</td><td>id=listing-price-input<datalist></datalist></td><td>289</td></tr>
<tr><td>type</td><td>id=listing-description-input<datalist></datalist></td><td>Authentic Bose QuietComfort headphones with noise cancelling. Barely used with carrying case.</td></tr>
<tr><td>storeEval</td><td>(function() { var dt = new DataTransfer(); var f = new File(['dummy content'], 'bose-qc45.jpg', { type: 'image/jpeg' }); dt.items.add(f); var inp = document.getElementById('listing-photos-input'); inp.files = dt.files; inp.dispatchEvent(new Event('change', { bubbles: true })); return true; })()<datalist></datalist></td><td>unused</td></tr>
<tr><td>click</td><td>id=listing-submit-btn<datalist></datalist></td><td></td></tr>
<tr><td>waitForElementPresent</td><td>id=listing-success-msg<datalist></datalist></td><td>8000</td></tr>
<tr><td>waitForElementPresent</td><td>id=btn-toggle-sold<datalist></datalist></td><td>8000</td></tr>
<tr><td>assertElementPresent</td><td>id=btn-edit-listing<datalist></datalist></td><td></td></tr>
<tr><td>assertElementPresent</td><td>id=btn-delete-listing<datalist></datalist></td><td></td></tr>
<tr><td>click</td><td>id=btn-toggle-sold<datalist></datalist></td><td></td></tr>
<tr><td>waitForElementPresent</td><td>id=listing-action-success-msg<datalist></datalist></td><td>5000</td></tr>
<tr><td>assertText</td><td>id=listing-detail-status<datalist></datalist></td><td>sold</td></tr>
<tr><td>click</td><td>id=btn-edit-listing<datalist></datalist></td><td></td></tr>
<tr><td>waitForElementPresent</td><td>id=edit-listing-price<datalist></datalist></td><td>3000</td></tr>
<tr><td>type</td><td>id=edit-listing-price<datalist></datalist></td><td>249</td></tr>
<tr><td>click</td><td>id=btn-save-edit<datalist></datalist></td><td></td></tr>
<tr><td>waitForElementPresent</td><td>id=listing-action-success-msg<datalist></datalist></td><td>5000</td></tr>
<tr><td>click</td><td>id=btn-delete-listing<datalist></datalist></td><td></td></tr>
<tr><td>waitForElementPresent</td><td>id=btn-confirm-delete<datalist></datalist></td><td>3000</td></tr>
<tr><td>click</td><td>id=btn-confirm-delete<datalist></datalist></td><td></td></tr>
<tr><td>waitForElementPresent</td><td>id=listings-search-input<datalist></datalist></td><td>5000</td></tr>
<tr><td>click</td><td>id=nav-btn-logout<datalist></datalist></td><td></td></tr>
<tr><td>waitForElementPresent</td><td>id=login-submit-btn<datalist></datalist></td><td>5000</td></tr>
</tbody></table>
</body>
</html>