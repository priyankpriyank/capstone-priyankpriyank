      "commands": [
        { "command": "open", "target": "/register", "value": "" },
        { "command": "waitForElementPresent", "target": "id=fullName", "value": "5000" },
        { "command": "executeScript", "target": "return \"katalon_\" + Math.floor(Date.now() / 1000) + \"@nexto.com\";", "value": "testEmail" },
