<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en" lang="en">
<head>
<meta content="text/html; charset=UTF-8" http-equiv="content-type" />
<title>FE-01_Register_And_Login</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3" data-tags="">FE-01: Register &amp; Login Flow (Req 1.1 - 1.3)</td></tr>
</thead>
<tbody>
<tr><td>open</td><td>/register<datalist></datalist></td><td></td></tr>
<tr><td>waitForElementPresent</td><td>id=fullName<datalist></datalist></td><td>5000</td></tr>
<tr><td>storeEval</td><td>"katalon_" + new Date().getTime() + "@nexto.com"<datalist></datalist></td><td>testEmail</td></tr>
<tr><td>type</td><td>id=fullName<datalist></datalist></td><td>Katalon User</td></tr>
<tr><td>type</td><td>id=email<datalist></datalist></td><td>${testEmail}</td></tr>
<tr><td>type</td><td>id=password<datalist></datalist></td><td>P@ssw0rd1!</td></tr>
<tr><td>click</td><td>id=register-submit-btn<datalist></datalist></td><td></td></tr>
<tr><td>assertText</td><td>id=register-success-msg<datalist></datalist></td><td>✓ Account created successfully</td></tr>
<tr><td>pause</td><td>1500<datalist></datalist></td><td></td></tr>
<tr><td>open</td><td>/login<datalist></datalist></td><td></td></tr>
<tr><td>waitForElementPresent</td><td>id=email<datalist><option>id=email</option></datalist></td><td>5000</td></tr>
<tr><td>type</td><td>id=email<datalist></datalist></td><td>${testEmail}</td></tr>
<tr><td>type</td><td>id=password<datalist></datalist></td><td>P@ssw0rd1!</td></tr>
<tr><td>click</td><td>id=login-submit-btn<datalist></datalist></td><td></td></tr>
<tr><td>waitForElementPresent</td><td>id=home-welcome-title<datalist></datalist></td><td>5000</td></tr>
<tr><td>assertText</td><td>id=home-welcome-title<datalist><option>id=home-welcome-title</option></datalist></td><td>Welcome to NexTo</td></tr>
<tr><td>assertElementPresent</td><td>id=nav-btn-logout<datalist></datalist></td><td></td></tr>
<tr><td>click</td><td>id=nav-btn-logout<datalist></datalist></td><td></td></tr>
<tr><td>waitForElementPresent</td><td>id=login-submit-btn<datalist></datalist></td><td>5000</td></tr>
</tbody></table>
</body>
</html>